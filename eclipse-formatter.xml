<?xml version="1.0" encoding="UTF-8"?>
<profiles version="13">
	<profile
		kind="CodeFormatterProfile"
		name="Project style"
		version="13">

		<!-- Отступы: пробелы вместо табуляции -->
		<setting
			id="org.eclipse.jdt.core.formatter.tabulation.char"
			value="tab"/>
		<setting
			id="org.eclipse.jdt.core.formatter.indentation.size"
			value="1"/>
		<setting
			id="org.eclipse.jdt.core.formatter.tabulation.size"
			value="8"/>

		<!-- Максимальная длина строки кода до переноса -->
		<setting
			id="org.eclipse.jdt.core.formatter.lineSplit"
			value="80"/>

		<!-- Фигурные скобки: открывающая скобка на той же строке -->
		<setting
			id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration"
			value="end_of_line"/>
		<setting
			id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration"
			value="end_of_line"/>
		<setting
			id="org.eclipse.jdt.core.formatter.brace_position_for_block"
			value="end_of_line"/>

		<!-- Закрывающая скобка на отдельной строке,
			только если список аргументов перенесён -->
		<setting
			id="org.eclipse.jdt.core.formatter.parentheses_positions_in_method_invocation"
			value="separate_lines_if_wrapped"/>
		<setting
			id="org.eclipse.jdt.core.formatter.parentheses_positions_in_method_delcaration"
			value="separate_lines_if_wrapped"/>
			
		<!-- Перенесённые строки: один уровень отступа -->
		<setting
			id="org.eclipse.jdt.core.formatter.continuation_indentation"
			value="1"/>
		<!-- При разбиении цепочек вызова каждый элемент на своей строке -->
		<setting
			id="org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation"
			value="80"/>
		<!-- При разбиении вызова метода каждый аргумент на своей строке -->
		<setting
			id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation"
			value="80"/>
		<setting
			id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_allocation_expression"
			value="80"/>

		<!-- Пробел после запятых и вокруг бинарных операторов -->
		<setting
			id="org.eclipse.jdt.core.formatter.insert_space_after_comma_in_method_invocation_arguments"
			value="insert"/>
		<setting
			id="org.eclipse.jdt.core.formatter.insert_space_before_binary_operator"
			value="insert"/>
		<setting
			id="org.eclipse.jdt.core.formatter.insert_space_after_binary_operator"
			value="insert"/>

		<!-- Пустые строки вокруг package и импортов -->
		<setting
			id="org.eclipse.jdt.core.formatter.blank_lines_after_package"
			value="1"/>
		<setting
			id="org.eclipse.jdt.core.formatter.blank_lines_before_imports"
			value="1"/>
		<setting
			id="org.eclipse.jdt.core.formatter.blank_lines_after_imports"
			value="1"/>

		<!-- Не склеивать уже перенесённые строки -->
		<!-- setting
			id="org.eclipse.jdt.core.formatter.join_wrapped_lines"
			value="false"/ -->

		<!-- Подсказки форматтеру в коде: @formatter:off и @formatter:on -->
		<setting
			id="org.eclipse.jdt.core.formatter.use_on_off_tags"
			value="true"/>
		<setting
			id="org.eclipse.jdt.core.formatter.disabling_tag"
			value="@formatter:off"/>
		<setting
			id="org.eclipse.jdt.core.formatter.enabling_tag"
			value="@formatter:on"/>

	</profile>
</profiles>
